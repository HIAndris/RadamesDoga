<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.ScrollPane?>

<?import javafx.scene.control.TextArea?>
<ScrollPane fitToHeight="true" fitToWidth="true" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="hiandris.radames.scenes.HelloController">

    <VBox alignment="CENTER">

        <Button fx:id="buttonNew" styleClass="kurvanagy-button" text="%menu.button.new" VBox.vgrow="ALWAYS" />

        <Button fx:id="buttonOpen" styleClass="kurvanagy-button" text="%menu.button.open" VBox.vgrow="ALWAYS" />

        <Button fx:id="buttonSettings" styleClass="kurvanagy-button" text="%menu.button.settings" onAction="#onSettingsClick" VBox.vgrow="ALWAYS" />

        <Button fx:id="buttonQuit" styleClass="kurvanagy-button" text="%menu.button.quit" VBox.vgrow="ALWAYS" />

    </VBox>
</ScrollPane>
